PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SIGNUP_EMAIL_REDIRECT_URL=http://localhost:5173/sign-in
COMMISSIONER_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
COOKIE_SECURE=

# Docker Compose serves the SPA and API from one port. These optional values
# override the localhost defaults in docker-compose.yml for a deployed origin.
# DOCKER_CLIENT_ORIGIN=https://your-domain.example
# DOCKER_SIGNUP_EMAIL_REDIRECT_URL=https://your-domain.example/sign-in
# DOCKER_COMMISSIONER_INVITE_REDIRECT_URL=https://your-domain.example/accept-invite
# DOCKER_PASSWORD_RESET_REDIRECT_URL=https://your-domain.example/reset-password
# DOCKER_COOKIE_SECURE=true

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_GOOGLE_MAPS_API_KEY=your-google-map-tiles-api-key
VITE_GOOGLE_MAP_TILES_LANGUAGE=en-CA
VITE_GOOGLE_MAP_TILES_REGION=CA
GOOGLE_MAPS_SERVER_API_KEY=your-server-only-geocoding-api-key

SESSION_COOKIE_NAME=crmp_access_token
REFRESH_COOKIE_NAME=crmp_refresh_token
COOKIE_SAME_SITE=lax
